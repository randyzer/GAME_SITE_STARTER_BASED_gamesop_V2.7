---
import type { ResolvedNavigationGroup } from "../../core/site-data";

interface Props {
  groups: ResolvedNavigationGroup[];
  currentRoute: string;
}

const { groups, currentRoute } = Astro.props;
---

<details class="mobile-nav">
  <summary class="mobile-nav__toggle">Menu <span aria-hidden="true">+</span></summary>
  <nav class="mobile-nav__panel" aria-label="Primary navigation">
    <ul class="mobile-nav__list">
      {groups.map((group) => {
        const label = group.label ?? group.page.title;
        const groupIsActive =
          currentRoute === group.page.route ||
          group.children.some((child) => currentRoute === child.route);

        return group.children.length > 0 ? (
          <li data-active={groupIsActive ? "true" : undefined}>
            <details class="mobile-nav__group">
              <summary>{label}</summary>
              <div class="mobile-nav__children">
                <a
                  class="mobile-nav__overview"
                  href={group.page.route}
                  aria-current={currentRoute === group.page.route ? "page" : undefined}
                  data-nav-page-id={group.page.pageId}
                >
                  Overview <span aria-hidden="true">→</span>
                </a>
                <ul>
                  {group.children.map((child) => (
                    <li data-nav-page-id={child.pageId}>
                      <a
                        href={child.route}
                        aria-current={currentRoute === child.route ? "page" : undefined}
                      >
                        {child.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          </li>
        ) : (
          <li
            data-active={groupIsActive ? "true" : undefined}
            data-nav-page-id={group.page.pageId}
          >
            <a
              href={group.page.route}
              aria-current={currentRoute === group.page.route ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</details>

<script is:inline>
  (() => {
    const mobile = document.querySelector(".mobile-nav");
    const header = mobile?.closest(".site-header");
    const desktop = header?.querySelector(".desktop-nav");
    const home = header?.querySelector(".brand");
    const summary = mobile?.querySelector(":scope > summary");
    if (!(mobile instanceof HTMLDetailsElement) || !(desktop instanceof HTMLElement) ||
      !(home instanceof HTMLElement) || !(summary instanceof HTMLElement) ||
      typeof window.matchMedia !== "function") return;

    // This matches the existing CSS navigation boundary, including exactly 900px.
    const mobileMode = window.matchMedia("(max-width: 900px)");
    const trigger = (disclosure) => disclosure.querySelector(":scope > summary");
    const close = (disclosure) => {
      disclosure.open = false;
      for (const nested of disclosure.querySelectorAll("details")) nested.open = false;
    };
    const restore = (disclosure) => {
      let visible = disclosure;
      for (let ancestor = disclosure.parentElement?.closest("details"); ancestor;
        ancestor = ancestor.parentElement?.closest("details")) {
        if (!ancestor.open) visible = ancestor;
      }
      trigger(visible)?.focus({ preventScroll: true });
    };

    mobile.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !(event.target instanceof Element)) return;
      const disclosure = event.target.closest("details[open]");
      if (!(disclosure instanceof HTMLDetailsElement) || !mobile.contains(disclosure)) return;
      event.preventDefault();
      event.stopPropagation();
      close(disclosure);
      restore(disclosure);
    });

    mobile.addEventListener("toggle", (event) => {
      const disclosure = event.target;
      if (!(disclosure instanceof HTMLDetailsElement) || !mobile.contains(disclosure) || disclosure.open) return;
      const hiddenFocus = disclosure.contains(document.activeElement) &&
        !trigger(disclosure)?.contains(document.activeElement);
      close(disclosure);
      if (hiddenFocus) restore(disclosure);
    }, true);

    mobile.addEventListener("click", (event) => {
      if (event.defaultPrevented || !(event.target instanceof Element)) return;
      const link = event.target.closest("a[href]");
      if (!(link instanceof HTMLElement) || !mobile.contains(link)) return;
      close(mobile);
      summary.focus({ preventScroll: true });
      const destination = new URL(link.href, window.location.href);
      const current = new URL(window.location.href);
      if (destination.origin !== current.origin || destination.pathname !== current.pathname ||
        destination.search !== current.search) return;
      let target;
      try { target = destination.hash ? document.getElementById(decodeURIComponent(destination.hash.slice(1))) : home; }
      catch { return; }
      if (!(target instanceof HTMLElement) || target.getClientRects().length === 0) return;
      if (!target.hasAttribute("tabindex")) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener("blur", () => target.removeAttribute("tabindex"), { once: true });
      }
      target.focus({ preventScroll: true });
    });

    mobileMode.addEventListener("change", () => {
      const active = document.activeElement;
      close(mobile);
      if (!(active instanceof HTMLElement)) return;
      if (mobileMode.matches) {
        if (desktop.contains(active)) summary.focus({ preventScroll: true });
      } else if (mobile.contains(active)) {
        const pageId = active.closest("[data-nav-page-id]")?.getAttribute("data-nav-page-id") ??
          active.closest(".mobile-nav__group")?.querySelector(".mobile-nav__overview")?.getAttribute("data-nav-page-id");
        const match = [...desktop.querySelectorAll("[data-nav-page-id]")]
          .find((element) => element.getAttribute("data-nav-page-id") === pageId);
        const destination = match?.matches("a[href]") ? match : match?.querySelector("a[href]");
        // Parent focus exposes the existing focus-within submenu before selecting a child.
        destination?.closest(".desktop-nav__group")?.querySelector(".desktop-nav__link")?.focus({ preventScroll: true });
        if (destination instanceof HTMLElement && destination.getClientRects().length > 0 &&
          getComputedStyle(destination).visibility !== "hidden") destination.focus({ preventScroll: true });
        else home.focus({ preventScroll: true });
      }
    });
    if (!mobileMode.matches) close(mobile);
  })();
</script>
