---
import type { MarkdownHeading } from "astro";

import { enabledPageCatalog, getRelatedPages, siteConfig } from "../../core/site-data";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildBreadcrumbTrail,
  buildCanonicalUrl,
  resolveStructuredIdentity,
} from "../../core/seo";
import type { PageInventoryEntry } from "../../data/schemas/page-inventory";
import { mediaCatalog } from "../../data/media/catalog";
import type { ImageAsset, VideoAsset } from "../../data/schemas/media";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameMedia from "../media/GameMedia.astro";
import ScreenshotGallery from "../media/ScreenshotGallery.astro";
import FAQ from "./FAQ.astro";
import QuickFacts from "./QuickFacts.astro";
import RelatedPages from "./RelatedPages.astro";
import Sources from "./Sources.astro";
import { selectWikiArticleHeadings } from "./wiki-article";

interface Props {
  page: PageInventoryEntry;
  headings?: MarkdownHeading[];
  quickFacts?: Array<{ label: string; value: string }>;
  sectionLabel?: string;
  heroMedia?: ImageAsset;
  galleryMedia?: ImageAsset[];
  trailerMedia?: VideoAsset;
  faq?: Array<{ question: string; answer: string }>;
}

const {
  page,
  headings = [],
  quickFacts = [],
  faq = [],
  sectionLabel = "Player guide",
} = Astro.props;
const mappedMedia = mediaCatalog.getPageMedia(page.pageId);
const {
  heroMedia = mappedMedia.heroMedia,
  galleryMedia = mappedMedia.galleryMedia,
  trailerMedia = mappedMedia.trailerMedia,
} = Astro.props;
const tocHeadings = selectWikiArticleHeadings(headings);
const showToc = tocHeadings.length >= 2;
const relatedPages = getRelatedPages(page);
const lastVerified = [...page.sources]
  .sort((left, right) => right.accessedAt.localeCompare(left.accessedAt))
  .at(0)?.accessedAt;
const canonical = buildCanonicalUrl(siteConfig, page.route);
const breadcrumbTrail = buildBreadcrumbTrail(
  siteConfig,
  page,
  enabledPageCatalog,
);
const structuredData = [
  buildBreadcrumbSchema(canonical, breadcrumbTrail),
  buildArticleSchema(siteConfig, page),
];
const authorAttribution = resolveStructuredIdentity(siteConfig, page).authorAttribution;
---

<BaseLayout page={page} structuredData={structuredData}>
  <main id="main-content">
    <article
      class="article wiki-article shell"
      data-pagefind-body={page.indexability === "index" ? true : undefined}
    >
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          {breadcrumbTrail.map((item, index) => (
            <li aria-current={index === breadcrumbTrail.length - 1 ? "page" : undefined}>
              {index === breadcrumbTrail.length - 1 ? item.name : <a href={item.url}>{item.name}</a>}
            </li>
          ))}
        </ol>
      </nav>

      <header class="article__header wiki-article__header reveal reveal--1">
        <p class="eyebrow">{sectionLabel}</p>
        <h1 data-pagefind-meta="title">{page.title}</h1>
        <p class="article__dek" data-pagefind-meta="description">{page.description}</p>
        <dl class="article__meta wiki-article__meta">
          <div>
            <dt>Last updated</dt>
            <dd><time datetime={page.updatedAt}>{page.updatedAt}</time></dd>
          </div>
          {lastVerified && (
            <div>
              <dt>Last verified</dt>
              <dd><time datetime={lastVerified}>{lastVerified}</time></dd>
            </div>
          )}
          {authorAttribution && (
            <div>
              <dt>Author</dt>
              <dd data-structured-author-id={authorAttribution.id}>{authorAttribution.name}</dd>
            </div>
          )}
        </dl>
      </header>

      {heroMedia && (
        <div class="page-media" data-media-placement="hero">
          <GameMedia asset={heroMedia} eager />
        </div>
      )}
      <QuickFacts items={quickFacts} />

      <div class:list={["article__layout", "wiki-article__layout", !showToc && "wiki-article__layout--single"]}>
        {showToc && (
          <aside class="article__rail wiki-article__toc">
            <nav aria-labelledby="wiki-toc-title">
              <p class="eyebrow" id="wiki-toc-title">On this page</p>
              <ol>
                {tocHeadings.map((heading) => (
                  <li data-depth={heading.depth}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )}

        <div class="prose"><slot /></div>
      </div>

      {galleryMedia.length > 0 && (
        <div class="page-media" data-media-placement="gallery">
          <ScreenshotGallery assets={galleryMedia} />
        </div>
      )}
      {trailerMedia && (
        <div class="page-media" data-media-placement="trailer">
          <GameMedia asset={trailerMedia} />
        </div>
      )}
      <FAQ items={faq} />
      <RelatedPages pages={relatedPages} />
      <Sources sources={page.sources} />
    </article>
  </main>
</BaseLayout>
